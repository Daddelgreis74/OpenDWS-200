{
  "name": "opendws-200-studio",
  "version": "0.1.0",
  "description": "OpenDWS-200 Desktop Studio (Live Telemetry, Control, CSV Logger & Firmware Updater)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.daddelgreis.opendws200studio",
    "productName": "OpenDWS-200 Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "OpenDWS-200-Studio-${version}-win-x64-portable.exe"
    }
  }
}
